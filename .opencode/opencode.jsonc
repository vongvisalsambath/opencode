{
  "$schema": "https://opencode.ai/config.json",
  "model": "buildnest-gateway/claude-opus-5-5",
  "providers": {
    "buildnest-gateway": {
      "name": "BuildNest Gateway",
      "env": ["BUILDNEST_GATEWAY_API_KEY"],
      "package": "@opencode/ai/providers/anthropic-compatible",
      "settings": {
        "baseURL": "https://buildnest-gateway.vercel.app/v1",
      },
      "models": {
        "claude-fable-5-1": { "name": "Claude Fable 5.1" },
        "claude-opus-5-5": { "name": "Claude Opus 5.5" },
        "claude-sonnet-5-5": { "name": "Claude Sonnet 5.5" },
        "claude-haiku-5-5": { "name": "Claude Haiku 5.5" },
      },
    },
  },
  "permission": {},
  "references": {
    "effect": {
      "repository": "github.com/Effect-TS/effect-smol",
      "description": "Use for Effect v4 and effect-smol implementation details",
    },
    "opencode-local": {
      "path": "~/.local/share/opencode",
      "description": "Contains opencode logs and data",
    },
  },
  "mcp": {},
  "tools": {
    "github-pr-search": false,
  },
  "experimental": {
    "part_rows": true,
  },
}
